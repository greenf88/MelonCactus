# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://meloncactus.com

# Server-only Resend settings. Replace the API key and sender only in an
# untracked .env.local file or in your hosting provider's environment settings.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@meloncactus.com
# Set this to a sender at your verified Resend sending domain.
CONTACT_FROM_EMAIL=
