{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".intelligence-build",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "scripts/intelligence-engine.ts",
    "src/lib/intelligence/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["src/lib/intelligence/**/*.test.ts"]
}
